@inbook{smith2024,
  author = {Micaiah Smith-Pierce and David Dement and Stephen Ruffin},
  title = {A High Order Discontinuous Galerkin Navier-Stokes Solver with Grid-Convergent Artificial Viscosity},
  booktitle = {AIAA SCITECH 2024 Forum},
  chapter = {},
  pages = {},
  doi = {10.2514/6.2024-2176},
  URL = {https://arc.aiaa.org/doi/abs/10.2514/6.2024-2176},
  eprint = {https://arc.aiaa.org/doi/pdf/10.2514/6.2024-2176},
  abstract = { This work presents a high-order discontinuous Galerkin solver for the Navier-Stokes equations on unstructured quad/hex meshes. It addresses two significant barriers to the practical application of high-order DG schemes, namely efficiency and shock capturing. We present an explicit multistage time integration scheme designed to maximize the time step, achieving a 10× increase in diffusion-dominated flows, although the time accuracy is reduced to first order. We also develop a novel, high-order-accurate smoothness-based artificial-viscosity scheme for shock capturing. By formulating the smoothness indicator in a way that is independent of the spatial discretization, this scheme avoids nonphysical oscillations which compromise the formal grid convergence of conventional smoothness indicators. Numerical evidence validates the accuracy of the solver across a range of flight conditions and suggests that performance is competitive with industry-standard solvers for some problems. }
}

